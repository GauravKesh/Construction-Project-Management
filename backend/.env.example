# Application
APP_NAME=Dashboard for Real-Time Monitoring of Construction Projects
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
ROOT_PATH=
FORWARDED_ALLOW_IPS=*
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Security & Authentication
SECRET_KEY=change-me-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Device key for HTTP ingestion (X-API-Key on POST /api/v1/telemetry/ingest); leave empty to require a user token
INGEST_API_KEY=

# PostgreSQL Database (System of Record)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=gaurav
POSTGRES_PASSWORD=
POSTGRES_DB=construction_db
DATABASE_URL=postgresql+asyncpg://gaurav@localhost:5432/construction_db
DATABASE_SYNC_URL=postgresql://gaurav@localhost:5432/construction_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# MongoDB (Raw Telemetry, CV Detections, Event Log)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=construction_mongo
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Redis (Cache, Rate Limit, Dedup, Sliding Windows, Streams, Socket.IO pubsub, Locks)
REDIS_URL=redis://localhost:6379/0

# MQTT Broker (Sensors Ingestion)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_SUB=sites/+/sensors/#
MQTT_KEEPALIVE=60

# Object Storage Abstraction (local or s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=construction-assets
S3_REGION=us-east-1

# Feature Flags & Degradation Modes
FEATURE_TIMESCALE=false
FEATURE_POSTGIS=false
CV_MODE=mock
CV_MODEL_PATH=./data/models/yolov8n.pt
CV_CONFIDENCE_THRESHOLD=0.45
CV_INFERENCE_FPS=2

# Notification Providers (console | smtp | twilio | fcm)
NOTIFY_PROVIDER_EMAIL=console
NOTIFY_PROVIDER_SMS=console
NOTIFY_PROVIDER_PUSH=console

# SMTP Settings (when NOTIFY_PROVIDER_EMAIL=smtp)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@buildtrack.com

# Twilio SMS Settings (when NOTIFY_PROVIDER_SMS=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notification Settings (when NOTIFY_PROVIDER_PUSH=fcm)
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Dev / Multi-Worker Options
RUN_EMBEDDED_WORKERS=false
LOG_LEVEL=INFO
