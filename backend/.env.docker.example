# Application
APP_NAME=Dashboard for Real-Time Monitoring of Construction Projects
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
ROOT_PATH=
FORWARDED_ALLOW_IPS=*
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Security & Authentication
SECRET_KEY=production-secret-key-change-to-cryptographic-hash
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database (System of Record)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=construction_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/construction_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/construction_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# MongoDB (Raw Telemetry, CV Detections, Event Log)
MONGO_URI=mongodb://mongo:27017
MONGO_DB=construction_mongo
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Redis (Cache, Rate Limit, Dedup, Sliding Windows, Streams, Socket.IO pubsub, Locks)
REDIS_URL=redis://redis:6379/0

# MQTT Broker (Sensors Ingestion)
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_SUB=sites/+/sensors/#
MQTT_KEEPALIVE=60

# Object Storage Abstraction (MinIO / S3 in Docker)
STORAGE_BACKEND=s3
STORAGE_LOCAL_PATH=/data/storage
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=construction-assets
S3_REGION=us-east-1

# Feature Flags & Degradation Modes
FEATURE_TIMESCALE=false
FEATURE_POSTGIS=false
CV_MODE=yolo
CV_MODEL_PATH=/data/models/yolov8n.pt
CV_CONFIDENCE_THRESHOLD=0.45
CV_INFERENCE_FPS=2

# Notification Providers
NOTIFY_PROVIDER_EMAIL=console
NOTIFY_PROVIDER_SMS=console
NOTIFY_PROVIDER_PUSH=console

# SMTP Settings
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@buildtrack.local

# Twilio SMS Settings
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Push Notification Settings
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# Dev / Multi-Worker Options
RUN_EMBEDDED_WORKERS=false
LOG_LEVEL=INFO
